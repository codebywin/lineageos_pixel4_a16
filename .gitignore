# Git ignore for LineageOS 23.2 (Android 16) Pixel 4

# Ignore heavy decompiled and temporary folders
dump_device/*
!dump_device/framework_vcam.jar
!dump_device/vcam_test.lic

# Android Studio and IDE files
.idea/
build/
*.bak
*.tmp
*.log

# Keystores and private credentials
*.keystore
keystore.properties
crave*.conf
*.conf
*.pem
*.key

# App temporary files
org.lineageos.camera.assistant/.idea/
org.lineageos.camera.assistant/build/
org.lineageos.camera.assistant/release.keystore
org.lineageos.camera.assistant/keystore.properties

# Allow XML manifests
!manifests/*.xml

pyinstxtractor.py
crave.bin
crave.bin_extracted/
commit-push.bat
Magisk*
*.img
CHAT_HISTORY.md

# Large APKs & zips in root (keep CameraAssistant.apk)
*.apk
!org.lineageos.camera.assistant/*.apk
*.zip
*.dex
*.png
!org.lineageos.camera.assistant/**
*.txt
!note.txt

# Root research/test scripts
*.py
*.bat
!flash_vcam_a16.bat
!org.lineageos.camera.assistant/*.bat
*.ps1
!flash_vcam_a16.ps1
!scripts/*.ps1
*.sh
!scripts/*.sh
*.prop
hidden_root_bank.md
ui_dump*.xml
**/.idea/
**/*.keystore
**/keystore.properties
